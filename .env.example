# Copy to .env.local and fill in — never commit real values here.
#
# The live project (confirmed 2026-08-24 against backend/.env in the
# tripagent-full checkout, and by directly querying its REST API): the
# consumer site_* tables (site_members, site_saved_items, site_member_events,
# site_member_prefs) live on project ref gnifmusartvwngcuquou. This is
# DIFFERENT from the older ref (owqmlofqgvyqkgazayoy) still hardcoded as
# js/backend.js's fallback default and referenced in SETUP.md/001_site_consumer_funnel.sql's
# header comment — those predate the "My Year" (site_saved_items) work and
# point at the wrong project for this schema. Do not copy that value here.
VITE_SUPABASE_URL=https://gnifmusartvwngcuquou.supabase.co

# The anon (publishable) key — safe for the browser, RLS enforces security.
# Get the current one from Supabase Studio -> Project Settings -> API, or
# from tripagent-full/backend/.env's SUPABASE_ANON_KEY (same project).
VITE_SUPABASE_ANON_KEY=
